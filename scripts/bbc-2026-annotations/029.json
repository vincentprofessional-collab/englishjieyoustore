  "items": [
    {"id":"a029_p02717_s001","level1":[{"label":"主语","text":"We"},{"label":"谓语1","text":"'ve"},{"label":"同位语","text":"all"},{"label":"谓语2","text":"been"}],"level2":[]},
    {"id":"a029_p02717_s002","level1":[],"level2":[]},
    {"id":"a029_p02717_s003","level1":[{"label":"主语","text":"Disappointment"},{"label":"谓语","text":"is"},{"label":"表语","text":"an unhappy feeling"},{"label":"时间状语从句","text":"when there is a gap between your expectations and reality"},{"label":"时间状语从句","text":"when something you desired failed to materialise"}],"level2":[]},
    {"id":"a029_p02717_s004","level1":[{"label":"主语","text":"It"},{"label":"谓语","text":"'s"},{"label":"表语","text":"a normal and natural reaction"}],"level2":[]},
    {"id":"a029_p02717_s005","level1":[{"label":"谓语","text":"Is"},{"label":"主语","text":"it"},{"label":"表语","text":"best to forget about it and move on, or allow yourself to feel the feels"}],"level2":[]},
    {"id":"a029_p02720_s001","level1":[{"label":"主语","text":"We"},{"label":"并列谓语1","text":"often can't control"},{"label":"宾语从句","text":"what happens in life"},{"label":"主语","text":"we"},{"label":"并列谓语2","text":"can control"},{"label":"宾语从句","text":"how we respond"},{"label":"时间状语从句","text":"when things don't go our way"}],"level2":[]},
    {"id":"a029_p02720_s002","level1":[{"label":"主语","text":"Dr Radha Modgil"},{"label":"同位语","text":"a UK family doctor and campaigner for wellbeing"},{"label":"谓语","text":"says"},{"label":"宾语从句","text":"that we should take time to process the disappointment"}],"level2":[]},
    {"id":"a029_p02720_s003","level1":[{"label":"主语","text":"We"},{"label":"谓语","text":"can often feel"},{"label":"宾语","text":"the need to move on straight away or ignore our feelings"},{"label":"条件状语从句","text":"if we take time to process them and talk them through"},{"label":"主语","text":"we"},{"label":"谓语","text":"can move forward"},{"label":"主语","text":"she"},{"label":"谓语","text":"says"}],"level2":[{"label":"后置定语","text":"to move on straight away or ignore our feelings"}]},
    {"id":"a029_p02720_s004","level1":[{"label":"主语","text":"she"},{"label":"谓语","text":"advises"},{"label":"宾语","text":"us"},{"label":"宾语补足语","text":"to see the opportunities"}],"level2":[]},
    {"id":"a029_p02720_s005","level1":[{"label":"主语","text":"Things"},{"label":"谓语","text":"may not have worked out"},{"label":"状语","text":"this time"},{"label":"时间状语从句","text":"when one door closes"},{"label":"主语","text":"a different, more exciting door"},{"label":"谓语","text":"may have opened"}],"level2":[]},
    {"id":"a029_p02723_s001","level1":[],"level2":[]},
    {"id":"a029_p02723_s002","level1":[{"label":"谓语","text":"Make sure"},{"label":"宾语从句","text":"your goals are realistic, not idealistic"},{"label":"谓语","text":"says"},{"label":"主语","text":"Dr Annette Clancy"},{"label":"同位语","text":"an organisational consultant who researches emotions in the workplace"}],"level2":[{"label":"定语从句","text":"who researches emotions in the workplace"}]},
    {"id":"a029_p02723_s003","level1":[{"label":"谓语","text":"Think"}],"level2":[]},
    {"id":"a029_p02723_s004","level1":[{"label":"状语","text":"When waiting for something significant like a job offer or test result"},{"label":"主语","text":"her advice"},{"label":"谓语","text":"is"},{"label":"表语","text":"to not get ahead of yourself"}],"level2":[]},
    {"id":"a029_p02723_s005","level1":[{"label":"时间状语从句","text":"When we anticipate a positive result"},{"label":"主语","text":"we"},{"label":"谓语","text":"often start imagining"},{"label":"宾语","text":"a future that doesn't yet exist"},{"label":"条件状语从句","text":"if that future doesn't materialise"},{"label":"主语","text":"we"},{"label":"谓语","text":"then have to grieve"},{"label":"宾语","text":"its loss"},{"label":"定语从句","text":"which can be upsetting"}],"level2":[{"label":"定语从句","text":"that doesn't yet exist"}]},
    {"id":"a029_p02726_s001","level1":[{"label":"谓语","text":"Try"},{"label":"宾语","text":"not to take it personally"}],"level2":[]},
    {"id":"a029_p02726_s002","level1":[{"label":"主语","text":"Disappointment"},{"label":"并列谓语1","text":"might make"},{"label":"宾语","text":"you"},{"label":"宾语补足语","text":"think"},{"label":"主语","text":"I"},{"label":"谓语","text":"'m"},{"label":"表语","text":"not good enough"},{"label":"并列谓语2","text":"lead"},{"label":"宾语","text":"you"},{"label":"宾语补足语","text":"to blame yourself"},{"label":"状语","text":"affecting your self-esteem"}],"level2":[]},
    {"id":"a029_p02726_s003","level1":[{"label":"主语","text":"It"},{"label":"谓语","text":"may cause"},{"label":"宾语","text":"you"},{"label":"宾语补足语","text":"to blame others"},{"label":"状语","text":"making you angry that they did not recognise your value"}],"level2":[{"label":"宾语从句","text":"that they did not recognise your value"}]},
    {"id":"a029_p02726_s004","level1":[{"label":"主语","text":"Dr Annette Clancy"},{"label":"谓语","text":"says"},{"label":"宾语从句","text":"both reactions miss the point"}],"level2":[]},
    {"id":"a029_p02726_s005","level1":[{"label":"谓语","text":"see"},{"label":"宾语","text":"disappointment"}],"level2":[]},
    {"id":"a029_p02726_s006","level1":[{"label":"主语","text":"Understanding this"},{"label":"插入语","text":"she says"},{"label":"谓语","text":"can be"},{"label":"表语","text":"an important way to develop resilience"}],"level2":[{"label":"后置定语","text":"to develop resilience"}]}
  ]
}
