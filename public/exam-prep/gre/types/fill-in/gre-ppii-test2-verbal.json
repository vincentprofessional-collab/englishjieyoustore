 13, 13, 13], "optionsVerified": true}}, {"id": "ppii-equivalence-q8", "number": 8, "group": "PowerPrep II Test 2 · 句子等價", "prompt": "Philby secretly loathed the host of the party that he was attending, but it seemed ______ to say so publicly.", "options": [{"label": "A", "text": "recondite"}, {"label": "B", "text": "tactless"}, {"label": "C", "text": "clever"}, {"label": "D", "text": "malign"}, {"label": "E", "text": "deft"}, {"label": "F", "text": "impolitic"}], "optionGroups": [], "answer": "BF", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "PPII_v2p0_t2_tc_se.pdf", "path": "填空/PPII_v2p0_t2_tc_se.pdf", "answerSourceFile": "PPII_v2p0_t2_tc_se.pdf", "answerSourceVerified": true, "page": 13, "pageVerified": true, "promptVerified": true, "optionPages": [13, 13, 13, 13, 13, 13], "optionsVerified": true}}, {"id": "ppii-equivalence-q9", "number": 9, "group": "PowerPrep II Test 2 · 句子等價", "prompt": "The slower-learning monkeys searched ______ but unintelligently: although they worked closely together,\nthey checked only the most obvious hiding places.", "options": [{"label": "A", "text": "competitively"}, {"label": "B", "text": "impulsively"}, {"label": "C", "text": "cooperatively"}, {"label": "D", "text": "deviously"}, {"label": "E", "text": "craftily"}, {"label": "F", "text": "harmoniously"}], "optionGroups": [], "answer": "CF", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "PPII_v2p0_t2_tc_se.pdf", "path": "填空/PPII_v2p0_t2_tc_se.pdf", "answerSourceFile": "PPII_v2p0_t2_tc_se.pdf", "answerSourceVerified": true, "page": 13, "pageVerified": true, "promptVerified": true, "optionPages": [13, 13, 13, 13, 13, 13], "optionsVerified": true}}, {"id": "ppii-equivalence-q10", "number": 10, "group": "PowerPrep II Test 2 · 句子等價", "prompt": "The report’s most significant weakness is its assumption that the phenomenon under study is ______, when\nin reality it is limited to a specific geographic area.", "options": [{"label": "A", "text": "unusual"}, {"label": "B", "text": "exceptional"}, {"label": "C", "text": "ubiquitous"}, {"label": "D", "text": "absolute"}, {"label": "E", "text": "universal"}, {"label": "F", "text": "restricted"}], "optionGroups": [], "answer": "CE", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "PPII_v2p0_t2_tc_se.pdf", "path": "填空/PPII_v2p0_t2_tc_se.pdf", "answerSourceFile": "PPII_v2p0_t2_tc_se.pdf", "answerSourceVerified": true, "page": 14, "pageVerified": true, "promptVerified": true, "optionPages": [14, 14, 14, 14, 14, 14], "optionsVerified": true}}, {"id": "ppii-equivalence-q11", "number": 11, "group": "PowerPrep II Test 2 · 句子等價", "prompt": "By about age eight, children’s phonetic capacities are fully developed but still ______; thus children at that\nage can learn to speak a new language with a native speaker’s accent.", "options": [{"label": "A", "text": "plastic"}, {"label": "B", "text": "vestigial"}, {"label": "C", "text": "inarticulate"}, {"label": "D", "text": "unformed"}, {"label": "E", "text": "nascent"}, {"label": "F", "text": "malleable"}], "optionGroups": [], "answer": "AF", "answerMode": "multi", "explanation": "(A) (F) 是唯一的一组同义字，可直接选。关键词fully developed，but表转折，\n空格要选与fully developed相对的负面字 (见后面说明)。分号表 “并列” 结构，后\n面thus表承续，分号后面那句可视为补充说明：儿童学新语言 (表示此语言非母语) 的\n口音 (前面特别提到phonetic capabilities) 能像母语人士一样好，所以“可塑性强”\n(学新语言的口音可被改变)，plastic/malleable虽不是负面字，但与fully developed\n相对应 (fully developed表示已经定型)，且与分号后的提示 “唯一呼应”，故为答\n案。\n(B) (C) (D) 皆负面字为陷阱选项，(B) (C) 无同义字不能选，(D) unformed不选\n是因为题目提到fully developed，fully developed but still unformed则自相矛盾，\n不合逻辑。(E) nascent无同义字，且无法和分号后的提示产生连结。广泛地说，(D) (E)\n也形成一组同义字 (GRE中的同义字只要概念接近即可，不须是严格意义上的同义字)，\n但同样无法和分号后面的提示产生连结。", "reviewReasons": [], "reviewRequired": false, "source": {"file": "PPII_v2p0_t2_tc_se.pdf", "path": "填空/PPII_v2p0_t2_tc_se.pdf", "answerSourceFile": "PPII_v2p0_t2_tc_se.pdf", "answerSourceVerified": true, "page": 14, "pageVerified": true, "promptVerified": true, "optionPages": [14, 14, 14, 14, 14, 14], "optionsVerified": true, "explanationSourceFile": "麟渡兮填空(简体中文）--附加OG,PPII 题目解析.pdf", "explanationSourcePage": 38, "explanationSourceVerified": true}}, {"id": "ppii-equivalence-q12", "number": 12, "group": "PowerPrep II Test 2 · 句子等價", "prompt": "Each member of the journalistic pair served as ______ the other: each refrained from publishing a given\npiece if the other doubted that it was ready to be printed.", "options": [{"label": "A", "text": "a check on"}, {"label": "B", "text": "an advocate for"}, {"label": "C", "text": "an impediment to"}, {"label": "D", "text": "a brake on"}, {"label": "E", "text": "an apologist for"}, {"label": "F", "text": "an intermediary for"}], "optionGroups": [], "answer": "AD", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "PPII_v2p0_t2_tc_se.pdf", "path": "填空/PPII_v2p0_t2_tc_se.pdf", "answerSourceFile": "PPII_v2p0_t2_tc_se.pdf", "answerSourceVerified": true, "page": 14, "pageVerified": true, "promptVerified": true, "optionPages": [14, 14, 14, 14, 14, 14], "optionsVerified": true}}, {"id": "ppii-equivalence-q13", "number": 13, "group": "PowerPrep II Test 2 · 句子等價", "prompt": "That the book’s argument was ______ became clear as soon as reviews appeared: there were holes, and\nreviewers delighted in pointing them out.", "options": [{"label": "A", "text": "wanting"}, {"label": "B", "text": "convoluted"}, {"label": "C", "text": "unintelligible"}, {"label": "D", "text": "penetrating"}, {"label": "E", "text": "flawed"}, {"label": "F", "text": "complex"}], "optionGroups": [], "answer": "AE", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "PPII_v2p0_t2_tc_se.pdf", "path": "填空/PPII_v2p0_t2_tc_se.pdf", "answerSourceFile": "PPII_v2p0_t2_tc_se.pdf", "answerSourceVerif