ing"}], [{"label": "D", "text": "visionaries"}, {"label": "E", "text": "profit mongers"}, {"label": "F", "text": "innocents"}], [{"label": "G", "text": "financial"}, {"label": "H", "text": "inertial"}, {"label": "I", "text": "creative"}]]}]}
