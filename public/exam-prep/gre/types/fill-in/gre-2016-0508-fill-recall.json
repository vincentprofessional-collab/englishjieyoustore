{"id": "gre-2016-0508-fill-recall", "exam": "gre", "title": "2016-05-08 填空考试回忆", "category": "填空", "kind": "practice", "source": "2016填空机经.pdf", "questionCount": 7, "answerCount": 7, "reviewCount": 7, "duplicateCount": 0, "duplicates": [], "questions": [{"id": "recall-20160508-fill-q1", "number": 1, "group": "2016-05-08 考试回忆 · 填空", "prompt": "World demand for oil had been intensified, but it slackened because China’s surge in oil\nconsumption had (i)______. Moreover, high oil prices had themselves started to act as a short-\nterm (ii)______ the global economy, thus further dampening demand.", "options": [{"label": "A", "text": "spread"}, {"label": "B", "text": "commenced"}, {"label": "C", "text": "slowed"}, {"label": "D", "text": "spur to"}, {"label": "E", "text": "drag on"}, {"label": "F", "text": "panacea for"}], "answer": "CE", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "2016填空机经.pdf", "path": "填空/2016填空机经.pdf", "answerSourceFile": "2016填空机经.pdf", "answerSourcePage": 25, "answerSourceVerified": true, "page": 5, "pageVerified": true, "promptVerified": true, "optionPages": [5, 5, 5, 5, 5, 5], "optionsVerified": true}, "optionGroups": [[{"label": "A", "text": "spread"}, {"label": "B", "text": "commenced"}, {"label": "C", "text": "slowed"}], [{"label": "D", "text": "spur to"}, {"label": "E", "text": "drag on"}, {"label": "F", "text": "panacea for"}]]}, {"id": "recall-20160508-fill-q2", "number": 2, "group": "2016-05-08 考试回忆 · 填空", "prompt": "The book captures the _____ of several politicians who spoke publicly of old-time virtues in\norder to mask private vices.", "options": [{"label": "A", "text": "probity"}, {"label": "B", "text": "dissemblance"}, {"label": "C", "text": "opportunism"}, {"label": "D", "text": "rectitude"}, {"label": "E", "text": "ingenuousness"}, {"label": "F", "text": "duplicity"}], "answer": "BF", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "2016填空机经.pdf", "path": "填空/2016填空机经.pdf", "answerSourceFile": "2016填空机经.pdf", "answerSourcePage": 25, "answerSourceVerified": true, "page": 5, "pageVerified": true, "promptVerified": true, "optionPages": [5, 5, 5, 5, 5, 5], "optionsVerified": true}}, {"id": "recall-20160508-fill-q3", "number": 3, "group": "2016-05-08 考试回忆 · 填空", "prompt": "Many researchers assume that politicians consider the preferences of the entire public, and not\nmerely those of likely voters, when making decisions. Yet, since the desire to be reelected is\ncentral, it is plausible that politicians (i)____ the opinions of likely voters in formulating their\npositions on issues. It is possible that researchers’ suppositions about policy makers’ (ii) ____\naggregate public opinion may serve to (iii) ____ the fact that only the preferences of likely voters\nactually matter.", "options": [{"label": "A", "text": "rely insufficiently on"}, {"label": "B", "text": "depart sporadically from"}, {"label": "C", "text": "attend disproportionate"}, {"label": "D", "text": "responsiveness to"}, {"label": "E", "text": "neglect of"}, {"label": "F", "text": "misrepresentation of"}, {"label": "G", "text": "mask"}, {"label": "H", "text": "reflect"}, {"label": "I", "text": "obviate\nly to"}], "answer": "CDG", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "2016填空机经.pdf", "path": "填空/2016填空机经.pdf", "answerSourceFile": "2016填空机经.pdf", "answerSourcePage": 25, "answerSourceVerified": true, "page": 5, "pageVerified": true, "promptVerified": true, "optionPages": [5, 5, 5, 5, 5, 5, 5, 5, 5], "optionsVerified": true}, "optionGroups": [[{"label": "A", "text": "rely insufficiently on"}, {"label": "B", "text": "depart sporadically from"}, {"label": "C", "text": "attend disproportionate"}], [{"label": "D", "text": "responsiveness to"}, {"label": "E", "text": "neglect of"}, {"label": "F", "text": "misrepresentation of"}], [{"label": "G", "text": "mask"}, {"label": "H", "text": "reflect"}, {"label": "I", "text": "obviate\nly to"}]]}, {"id": "recall-20160508-fill-q4", "number": 4, "group": "2016-05-08 考试回忆 · 填空", "prompt": "The often-cited parallels between human communities and insect colonies are _____: the\ncooperation found among social insects is essentially due to the insects genetic ties, while\nhumans often collaborate with non-relatives.", "options": [{"label": "A", "text": "superficial"}, {"label": "B", "text": "obvious"}, {"label": "C", "text": "hackneyed"}, {"label": "D", "text": "contradictory"}, {"label": "E", "text": "uncanny"}], "answer": "A", "answerMode": "choice", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "2016填空机经.pdf", "path": "填空/2016填空机经.pdf", "answerSourceFile": "2016填空机经.pdf", "answerSourcePage": 25, "answerSourceVerified": true, "page": 6, "pageVerified": true, "promptVerified": true, "optionPages": [6, 6, 6, 6, 6], "optionsVerified": true}}, {"id": "recall-20160508-fill-q5", "number": 5, "group": "2016-05-08 考试回忆 · 填空", "prompt": "An abundance of nutrient-rich pollution in estuaries causes algae to ______, much as\nhouseplants grow better when their soil contains added fertilizer.", "options": [{"label": "A", "text": "abound"}, {"label": "B", "text": "proliferate"}, {"label": "C", "text": "stagnate"}, {"label": "D", "text": "coalesce"}, {"label": "E", "text": "collect"}, {"label": "F", "text": "diversify"}], "answer": "AB", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "2016填空机经.pdf", "path": "填空/2016填空机经.pdf", "answerSourceFile": "2016填空机经.pdf", "answerSourcePage": 25, "answerSourceVerified": true, "page": 6, "pageVerified": true, "promptVerified": true, "optionPages": [6, 6, 6, 6, 6, 6], "optionsVerified": true}}, {"id": "recall-20160508-fill-q6", "number": 6, "group": "2016-05-08 考试回忆 · 填空", "prompt": "There are two opposing theories about mountain formation and climate over the past 40\nmillion years: either the surge of mountain building (i)______ the global cooling, or vice versa.\nThe first of these two theories asserts that widespread mountain building cooled the earth as a\nresult of the (ii)______ mountains and climate. For example, mountain glaciers tent to be\n(iii)______: once established, they increase the reflectivity of the surface, thus lowering\ntemperatures and allowing more ice to form.", "options": [{"label": "A", "text": "superseded"}, {"label": "B", "text": "halted"}, {"label": "C", "text": "caused"}, {"label": "D", "text": "disparity between"}, {"label": "E", "text": "feedback between"}, {"label": "F", "text": "complexity of"}, {"label": "G", "text": "unpredictable"}, {"label": "H", "text": "static"}, {"label": "I", "text": "self-perpetuating"}], "answer": "CEI", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "2016填空机经.pdf", "path": "填空/2016填空机经.pdf", "answerSourceFile": "2016填空机经.pdf", "answerSourcePage": 25, "answerSourceVerified": true, "page": 6, "pageVerified": true, "promptVerified": true, "optionPages": [6, 6, 6, 6, 6, 6, 6, 6, 6], "optionsVerified": true}, "optionGroups": [[{"label": "A", "text": "superseded"}, {"label": "B", "text": "halted"}, {"label": "C", "text": "caused"}], [{"label": "D", "text": "disparity between"}, {"label": "E", "text": "feedback between"}, {"label": "F", "text": "complexity of"}], [{"label": "G", "text": "unpredictable"}, {"label": "H", "text": "static"}, {"label": "I", "text": "self-perpetuating"}]]}, {"id": "recall-20160508-fill-q7", "number": 7, "group": "2016-05-08 考试回忆 · 填空", "prompt": "It is possible for human to go 40 or more hours without sleep and still be able to (i)______\ninformation acquired at the beginning of the sleepless period. Thus, when we are considering a\nrole for sleep in human memory consolidation, we are referring to a possible role in the\n(ii)______encoding of information and optimizing of recall, not a (iii)______ of sleep for recalling\nevents of the prior day.", "options": [{"label": "A", "text": "legitimate"}, {"label": "B", "text": "augment"}, {"label": "C", "text": "disgorge"}, {"label": "D", "text": "longer-term"}, {"label": "E", "text": "acute"}, {"label": "F", "text": "qualitative"}, {"label": "G", "text": "requirement"}, {"label": "H", "text": "surplus"}, {"label": "I", "text": "facet"}], "answer": "CDG", "answerMode": "multi", "explanation": "", "reviewReasons": ["来源未提供逐题解析"], "reviewRequired": true, "source": {"file": "2016填空机经.pdf", "path": "填空/2016填空机经.pdf", "answerSourceFile": "2016填空机经.pdf", "answerSourcePage": 25, "answerSourceVerified": true, "page": 7, "pageVerified": true, "promptVerified": true, "optionPages": [7, 7, 7, 7, 7, 7, 7, 7, 7], "optionsVerified": true}, "optionGroups": [[{"label": "A", "text": "legitimate"}, {"label": "B", "text": "augment"}, {"label": "C", "text": "disgorge"}], [{"label": "D", "text": "longer-term"}, {"label": "E", "text": "acute"}, {"label": "F", "text": "qualitative"}], [{"label": "G", "text": "requirement"}, {"label": "H", "text": "surplus"}, {"label": "I", "text": "facet"}]]}]}
