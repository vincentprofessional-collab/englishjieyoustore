NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
COS_MEDIA_ENABLED=false
TENCENT_SECRET_ID=your-server-only-secret-id
TENCENT_SECRET_KEY=your-server-only-secret-key
TENCENT_COS_BUCKET=your-bucket-name-appid
TENCENT_COS_REGION=your-bucket-region
NEXT_PUBLIC_VOCABULARY_AUDIO_BASE_URL=https://your-audio-cdn.example.com/word-audio
# Server-only, bucket-scoped R2 Object Read credentials for paid BBC audio.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BBC_AUDIO_BUCKET=englishjieyou-bbc-audio
R2_BBC_AUDIO_ACCESS_KEY_ID=your-read-only-r2-access-key-id
R2_BBC_AUDIO_SECRET_ACCESS_KEY=your-read-only-r2-secret-access-key

# Optional server-only salt for hashing visitor IPs in analytics.
SITE_ANALYTICS_IP_SALT=replace-with-a-long-random-string

# Only for local seed scripts. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional local-only overrides.
VOCABULARY_SOURCE_PATH=/absolute/path/to/flat-vocabulary.json
ECDICT_SOURCE_PATH=/absolute/path/to/ecdict.csv
VOCABULARY_AUDIO_DIR=/absolute/path/to/word-audio
